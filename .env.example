# Backend environment variables — copy to .env and fill in real values.
# Do NOT commit the real .env (it is gitignored).

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Railway/Render inject this automatically).
DATABASE_URL=postgresql://user:password@localhost:5432/land_here

# JWT signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(64))"
# MINIMUM 64 characters — short keys are rejected at startup.
SECRET_KEY=change-me-to-a-64-char-random-hex-string

ALGORITHM=HS256
# Access token TTL in minutes (1 hour).
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token TTL in minutes (30 days).
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. "*" is fine for local dev only.
# Production: set to your real domain, e.g. "https://api.landhere.app"
CORS_ALLOW_ORIGINS=*

# ── Proxy headers (set true on Railway/Render/Fly) ─────────────────────────
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1

# ── External APIs (optional — data ingestion only) ──────────────────────────
SCORECARD_API_KEY=your-college-scorecard-api-key
OPENALEX_API_KEY=your-openalex-api-key

# Unsplash Access Key for GET /images/city (server-side only; never expose to
# the mobile bundle) — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ── Rate limiting ───────────────────────────────────────────────────────────
# Shared Redis backend for rate limiting. Leave empty for local development
# (in-memory, per-process). In production, start.sh forces --workers 1 while
# this is unset, because in-memory limits do not coordinate across workers —
# N workers would silently multiply every published limit by N.
#   Render: Dashboard → New → Key Value, then use its internal connection URL.
REDIS_URL=

# Set to "production" in deployed environments: enforces a strong SECRET_KEY at
# startup and enables production-only warnings.
ENV=development

# ── LandHere Pro / App Store verification ───────────────────────────────────
# NONE of these is a secret. Apple's root CAs are public trust anchors, the
# bundle id ships in every build, and the numeric app id is in every App Store
# URL. There is no .p8, no issuer id, and no shared secret anywhere in this
# project — if you find yourself adding one, verification has moved somewhere it
# should not be.

# The app's bundle identifier. Every transaction must carry this exact value.
APPLE_BUNDLE_ID=com.landhere.app

# The in-app purchase product identifier. NOT the same as APPLE_BUNDLE_ID:
# the bundle id names the app, this names the thing sold inside it.
APPLE_PRO_PRODUCT_ID=com.landhere.app.pro

# Numeric App Store Connect app id ("Apple ID" on the App Information page).
# REQUIRED to verify Production transactions — without it, no Production
# verifier is constructed at all and /purchases/verify returns 503.
# Unknown until the App Store Connect record exists.
APPLE_APP_APPLE_ID=

# Directory containing Apple's PUBLIC root certificates, downloaded from
# https://www.apple.com/certificateauthority/ (AppleRootCA-G3.cer and friends).
# Empty = purchase verification is not configured and the endpoints return 503
# rather than trusting anything they cannot check.
APPLE_ROOT_CA_DIR=

# Accept StoreKit Sandbox transactions. REQUIRED for TestFlight, where every
# purchase is a sandbox purchase. Leave false for a public release so nobody
# gets Pro free with a sandbox Apple ID.
APPLE_ACCEPT_SANDBOX=false

# OCSP revocation checking of Apple's certificate chain. Leave true in
# production: it is the difference between "chains to Apple" and "chains to a
# cert Apple has not revoked". Costs one network round trip per verification.
APPLE_ENABLE_ONLINE_CHECKS=true
