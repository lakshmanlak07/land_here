# Backend environment variables — copy to .env and fill in real values.
# Do NOT commit the real .env (it is gitignored).

# PostgreSQL connection string. URL-encode special chars in the password
# (e.g. @ -> %40).
DATABASE_URL=postgresql://user:password@localhost:5432/land_here

# JWT signing key — use a long, random string in production.
SECRET_KEY=change-me-to-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# College Scorecard / data.gov API key — https://api.data.gov/signup/
SCORECARD_API_KEY=your-college-scorecard-api-key

# OpenAlex polite/authenticated pool key — https://openalex.org/
OPENALEX_API_KEY=your-openalex-api-key
