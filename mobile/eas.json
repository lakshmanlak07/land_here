{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "staging": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://landhere-api-staging.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "SET_IN_EAS_DASHBOARD",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "SET_IN_EAS_DASHBOARD",
        "EXPO_PUBLIC_TERMS_URL": "SET_IN_EAS_DASHBOARD",
        "EXPO_PUBLIC_SUPPORT_URL": "SET_IN_EAS_DASHBOARD"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "lakshmanlak07@gmail.com",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "REPLACE_WHEN_ANDROID_SHIPS"
      }
    }
  }
}
