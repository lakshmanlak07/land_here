# Mobile (Expo) environment variables — copy to .env and fill in real values.
# Do NOT commit the real .env (it is gitignored).
# NOTE: EXPO_PUBLIC_* vars are bundled into the client build and are NOT secret.

# Base URL of the backend API (use your machine's LAN IP for a physical device).
EXPO_PUBLIC_API_URL=http://localhost:8000

# NOTE: the Unsplash key moved server-side (backend .env: UNSPLASH_ACCESS_KEY).
# Never add credentials under an EXPO_PUBLIC_ name — they ship in the bundle.
